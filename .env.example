# ==============================================================================
# Finomaly Environment Configuration Template
# COPY THIS FILE TO .env.local AND POPULATE WITH YOUR SECURE KEYS.
# DO NOT COMMIT .env.local OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# 1. Supabase server-side database access
# Use the Supabase Secret key (sb_secret_...) here. In projects showing legacy keys,
# use service_role instead. This key bypasses RLS; keep it server-only.
# SUPABASE_URL is the same Project URL as NEXT_PUBLIC_SUPABASE_URL below.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_replace-with-your-secret-key"

# 2. Supabase Auth browser configuration
# Use the Publishable key (sb_publishable_...) here, or the legacy anon key.
# This key is safe for browser use; database access is still controlled by RLS.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_replace-with-your-publishable-key"

# 3. Optional API key for the separate enroll/verify endpoints (not a Supabase key)
# Used for server-to-server calls to POST /api/enroll and POST /api/verify
API_KEY="generate-a-strong-random-api-key-here"

# 4. Optional administrative key for the global audit endpoint (not a Supabase key)
# Required to access cross-tenant / global audit logs via GET /api/audit?userId=all
ADMIN_API_KEY="generate-a-strong-random-admin-key-here"
