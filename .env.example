# ==============================================================================
# Finomaly Environment Configuration Template
# COPY THIS FILE TO .env.local AND POPULATE WITH YOUR SECURE KEYS.
# DO NOT COMMIT .env.local OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# 1. Supabase PostgreSQL Backend (Server-Side Only)
# Never expose SUPABASE_SERVICE_ROLE_KEY to client components (never prefix with NEXT_PUBLIC_)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-secure-supabase-service-role-key"

# 2. Server API Key
# Used for server-to-server calls to POST /api/enroll and POST /api/verify
API_KEY="generate-a-strong-random-api-key-here"

# 3. Administrative Operator Key
# Required to access cross-tenant / global audit logs via GET /api/audit?userId=all
ADMIN_API_KEY="generate-a-strong-random-admin-key-here"
